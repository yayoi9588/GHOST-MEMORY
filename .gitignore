# ============================================================
# Unity 6000.3.23f1
# GitHub Desktop / Team Development
# ============================================================

# This .gitignore file should be placed at the root
# of your Unity project directory.
#
# Based on:
# https://github.com/github/gitignore/blob/main/Unity.gitignore


# ============================================================
# Unity generated folders
# ============================================================

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Unity log files
*.log


# ============================================================
# Memory Captures / Recordings
# ============================================================

# MemoryCaptures can become very large and may contain
# sensitive information.
/[Mm]emoryCaptures/

# Unity Recorder output
/[Rr]ecordings/


# ============================================================
# Asset Store Tools
# ============================================================

# Uncomment if Asset Store Tools should not be shared.
# /[Aa]ssets/AssetStoreTools*


# ============================================================
# IDE / Editor generated files
# ============================================================

# JetBrains Rider Unity plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache
.vs/

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/

# Gradle cache
.gradle/

# Autogenerated solution/project files
ExportedObj/
.consulo/

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.sln.iml


# ============================================================
# Unity generated meta files
# ============================================================

*.pidb.meta
*.pdb.meta
*.mdb.meta


# ============================================================
# Crash reports
# ============================================================

sysinfo.txt


# ============================================================
# Builds
# ============================================================

*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app


# ============================================================
# Crashlytics
# ============================================================

crashlytics-build.properties


# ============================================================
# Addressables
# ============================================================

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*


# ============================================================
# Temporary Android Assets
# ============================================================

/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*


# ============================================================
# Operating System generated files
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*


# ============================================================
# Temporary / Backup files
# ============================================================

*.temp
*.bak
*.swp
*~


# ============================================================
# IMPORTANT
# ============================================================

# DO NOT ignore:
#
# /Assets/
# /Packages/
# /ProjectSettings/
#
# These directories must be committed for Unity team development.
#
# Also DO NOT ignore normal *.meta files.
# Unity uses .meta files to maintain GUID references between assets.# ============================================================
